{
  "skill_name": "auto-channel-setup",
  "skill_version": "1.0",
  "verification_required": true,
  "verification_method": "real_cloudpss_emt_channel_setup",
  "test_model": "model/<your-account>/IEEE3",
  "evals": [
    {
      "id": 1,
      "name": "EMT通道巡检",
      "goal": "验证能够从真实CloudPSS EMT模型识别通道元件和输出分组",
      "workflow": [
        "Model.fetch",
        "getAllComponents",
        "inspect output_channels"
      ],
      "pass_criteria": [
        "识别至少一个_newChannel通道",
        "识别EMT job",
        "输出通道分组摘要"
      ]
    },
    {
      "id": 2,
      "name": "本地工作副本通道配置仿真",
      "goal": "验证本地重组output_channels后能执行真实CloudPSS EMT并读取目标波形",
      "workflow": [
        "Model(deepcopy(model.toJSON()))",
        "update output_channels",
        "runEMT",
        "getPlotChannelData"
      ],
      "pass_criteria": [
        "EMT仿真状态为成功",
        "目标通道出现在仿真结果中",
        "目标通道采样点数大于0"
      ]
    }
  ]
}
