{
  "skill_name": "short-circuit-analysis",
  "skill_version": "1.0",
  "verification_required": true,
  "verification_method": "real_cloudpss_emt_short_circuit_analysis",
  "test_model": "model/CloudPSS/IEEE3",
  "evals": [
    {
      "id": 1,
      "name": "真实EMT短路电流指标",
      "goal": "验证能够从真实CloudPSS EMT job result读取电流或等效功率/电压通道并计算短路相关指标",
      "workflow": [
        "Model.fetch or Model.load",
        "runEMT",
        "getPlots",
        "getPlotChannelData",
        "analyze_short_circuit"
      ],
      "pass_criteria": [
        "EMT仿真成功",
        "至少分析一个电流或等效电流通道",
        "每个通道包含峰值、RMS、窗口RMS和短路容量字段",
        "summary包含最大电流、最大短路容量和通道数量"
      ]
    },
    {
      "id": 2,
      "name": "短路分析产物导出",
      "goal": "验证短路分析结果能够导出为JSON、CSV和Markdown报告",
      "workflow": [
        "write_summary_json",
        "write_channel_csv",
        "write_markdown_report"
      ],
      "pass_criteria": [
        "导出文件存在且非空",
        "CSV包含通道、峰值、RMS、短路容量和估算方法字段",
        "输出中不包含凭据值"
      ]
    }
  ]
}
